# Copy to .env for local work. In production every one of these comes from the
# task definition, a ConfigMap or a Secret — .env is gitignored and is never
# baked into the image.
#
# Only the four marked REQUIRED have no usable default.

# ── the HTTP trigger ────────────────────────────────────────────────────────
# REQUIRED. The shared secret a caller presents as `X-Trigger-Token`. With it
# unset the trigger endpoints answer 503 and /readyz reports unready — an
# unauthenticated trigger is a button that spends money on Soniox, OpenAI and
# ~97 GB/day of transfer from a partner's server.
PIPELINE_TRIGGER_TOKEN=

# What the pod does as it comes up: "full" (fetch the day and audit it),
# "audit" (audit whatever is already UNPROCESSED), or empty for nothing.
# This is the "trigger it when the pod starts" path; it needs no probe and no
# postStart hook.
RUN_ON_STARTUP=

# How long shutdown waits for a run in flight. 0 is right for Kubernetes: a pod
# replaced mid-run is ordinary, the rows stay UNPROCESSED and the next run picks
# them up. Raise it only if terminationGracePeriodSeconds is raised to match.
SHUTDOWN_GRACE_SEC=0

PORT=8000

# ── Cloud Connect ───────────────────────────────────────────────────────────
CC_BASE_URL=https://crm2.cloud-connect.in/ccpl_api/v1.4
# REQUIRED. Their tenant API token.
CC_TOKEN_ID=
CC_USER_TYPE=TENANT
CC_TIMEOUT_SEC=30

# ── AWS ─────────────────────────────────────────────────────────────────────
# In production these are the only three that are set: credentials come from
# the pod's IAM role via the default chain, never from configuration.
AWS_REGION=eu-north-1
CALLS_TABLE=calls
DIRECTORY_TABLE=directory
AUDIO_BUCKET=call-auditing-media
# Set to upgrade recordings from SSE-S3 to SSE-KMS, which is what an auditor
# asking "who can decrypt this" wants to see.
S3_KMS_KEY_ID=
# Only for DynamoDB Local / MinIO. Unset against real AWS.
DYNAMO_ENDPOINT_URL=
S3_ENDPOINT_URL=

# ── the AI pipeline ─────────────────────────────────────────────────────────
# REQUIRED (both). Without them the stub runs instead and every audit is
# synthetic — which is fine for a rehearsal and silently worthless in
# production, so check /readyz's `pipeline` line after a deploy.
SONIOX_API_KEY=
OPENAI_API_KEY=
# The job refuses to start on anything else: gpt-5.4-mini is 3.25x the price
# for identical output, and a typo here is invisible until the invoice.
AUDIT_MODEL=gpt-5.6-luna
ANALYSIS_MODEL=gpt-5.6-luna
# Set deliberately to run on a different model. Not a flag anyone should need.
ALLOW_ANY_MODEL=
# Replaces the four AI stages with a schema-valid stub. Rehearsals only.
STUB_PIPELINE=

# ── the run ─────────────────────────────────────────────────────────────────
# The business-day boundary, on the tenant clock (IST).
BATCH_DAY_START_HOUR=2
BATCH_DAY_BOUNDARY_GRACE_MIN=15
# The call log API has no pagination and no truncation signal, so the day is
# fetched an hour at a time.
BATCH_SLICE_MINUTES=60
BATCH_STUCK_AFTER_MIN=60
# A safety cap, not a target. Reaching it means the window was wrong.
BATCH_MAX_CALLS_PER_RUN=5000
# How long a run may take, and how long before that it stops starting new work
# so the audits in flight can finish.
BATCH_DEADLINE_MIN=360
BATCH_DRAIN_MARGIN_MIN=20
BATCH_RUN_SUMMARY_TTL_DAYS=90

# Downloads are network wait. Four, because at peak this pulls ~97 GB a day
# from a partner's server whose behaviour under load is not known.
DOWNLOAD_CONCURRENCY=4
INGEST_MAX_ATTEMPTS=3
INGEST_BACKOFF_SEC=5
# Audits in flight per pod. The ceiling is OpenAI's tokens-per-minute, not CPU:
# ~60,000 tpm per call, so Tier 3 (4M) allows ~66 across all pods.
AUDIT_CONCURRENCY=25

# ── the process ─────────────────────────────────────────────────────────────
# Must be writable and hold AUDIT_CONCURRENCY recordings at once — 25 x ~32 MB
# is about 1 GB of ephemeral storage.
WORK_DIR=/var/lib/call-auditing/workdir
KEEP_WORKDIR=
LOG_LEVEL=INFO
# One JSON object per line, for a log shipper.
LOG_JSON=
# The roster fallback when the directory table cannot be read.
AGENTS_PATH=
